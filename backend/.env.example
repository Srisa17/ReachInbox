NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis (BullMQ + rate-limit counters)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Slack OAuth — create an app at https://api.slack.com/apps, add the
# "incoming-webhook" and "chat:write" scopes, and set the redirect URL
# below as an OAuth Redirect URL on the app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Scheduling / throttling defaults (overridable per-sender in the DB)
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=100

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails
# Set to "true" to run without Elasticsearch (search endpoints return empty results)
ELASTICSEARCH_DISABLED=false
